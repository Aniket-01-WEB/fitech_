SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Cloudflare R2 (S3-compatible) — storage for uploaded notes/recordings.
# Create a scoped API token in the Cloudflare dashboard: R2 -> Manage API
# Tokens. The backend is the only thing that ever holds these; it mints
# short-lived presigned PUT/GET URLs per request, it never proxies bytes.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=fitech
