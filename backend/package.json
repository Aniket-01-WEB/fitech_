{
  "name": "matrix-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Node/Express API for the MATRIX FinTech Club app — talks to Supabase Postgres, RLS-respecting (no service-role key).",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "echo 'No build step required for backend'",
    "start": "node src/server.js",
    "keepalive": "node scripts/keepalive.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "zod": "^4.5.4"
  }
}
